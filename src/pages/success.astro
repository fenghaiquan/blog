---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SUPPORT_EMAIL, PRODUCT_NAME, PRODUCT_DOWNLOAD_URL } from '../consts';
import '../styles/success.css';
---

<BaseLayout
	title="支付成功 - 冯海泉"
	description="付款已确认，感谢支持。"
	ogImage="/og/default.png"
>
	<section class="page-header">
		<div class="container">
			<p class="page-header-eyebrow">Payment</p>
			<h1 class="page-header-title">支付成功 🎉</h1>
			<p class="page-header-desc">付款已确认，感谢支持！</p>
		</div>
	</section>

	<section class="success-section">
		<div class="container">
			<div class="success-card">
				<p class="success-check" aria-hidden="true">✓</p>
				<h2 class="success-title">购买完成</h2>
				<p class="success-desc">
					感谢支持！你的{PRODUCT_NAME}（PDF · 26 页）已就绪，点击下方按钮下载：
				</p>
				<a href={PRODUCT_DOWNLOAD_URL} class="success-download" download>⬇ 下载 PDF（约 2.6 MB）</a>
				<p class="success-note">
					下载遇到问题？联系
					<a href={`mailto:${SUPPORT_EMAIL}`} class="success-link">{SUPPORT_EMAIL}</a>，3 个工作日内必复
				</p>
				<a href="/blog" class="success-back">← 返回博客</a>
			</div>
		</div>
	</section>
</BaseLayout>
